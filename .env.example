# Porta e host do servidor local
PORT=3000
HOST=127.0.0.1

# Fuso horário obrigatório do sistema
TIMEZONE=America/Sao_Paulo

# Janela de atendimento padrão (formato HH:MM)
DEFAULT_WINDOW_START=17:00
DEFAULT_WINDOW_END=00:00

# Caminhos locais de persistência (relativos à raiz do projeto)
DB_PATH=./storage/database/negao_lanches.db
AUTH_DIR=./storage/auth

# Opcional: defina uma senha/PIN para proteger o painel local (deixe vazio para acesso direto em localhost)
PANEL_ACCESS_KEY=

# Nível de log do Baileys (silent, fatal, error, warn, info, debug)
WHATSAPP_LOG_LEVEL=warn
